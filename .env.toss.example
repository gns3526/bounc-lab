VITE_API_BASE_URL=https://penguin-bounce.overwatchkr.workers.dev
VITE_PUBLIC_APP_URL=https://penguin-bounce.overwatchkr.workers.dev
TOSS_APP_NAME=penguin-bounce
# 앱인토스 콘솔에서 발급한 운영용 전면 광고 그룹 ID로 반드시 교체하세요.
# toss-dev 빌드는 이 값을 비우면 ait-ad-test-interstitial-id를 자동 사용합니다.
VITE_TOSS_INTERSTITIAL_AD_GROUP_ID=replace-with-apps-in-toss-production-interstitial-ad-group-id
ALLOWED_ORIGINS=https://penguin-bounce.web.tossmini.com,https://penguin-bounce.private-web.tossmini.com
NODE_ENV=production
DATA_FILE=/data/maps.json
PUBLISH_SECRET=replace-with-a-long-random-production-secret
