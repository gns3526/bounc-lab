# 32바이트 이상의 예측 불가능한 문자열을 운영 환경의 비밀값으로 설정하세요.
PUBLISH_SECRET=replace-with-a-long-random-secret
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
DATA_FILE=./data/maps.json
# Optional for ordinary web development. Android release builds require this
# canonical HTTPS URL so shared map links never point to the WebView localhost.
VITE_PUBLIC_APP_URL=
# 앱인토스 콘솔에서 확정된 변경 불가능한 appName입니다.
TOSS_APP_NAME=penguin-bounce
# 쉼표로 구분한 추가 웹 Origin입니다. TOSS_APP_NAME의 SDK 3 Origin 두 개는 자동 허용됩니다.
ALLOWED_ORIGINS=
